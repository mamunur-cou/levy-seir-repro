import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import odeint


def seir_model(y,t,N,A,beta1,beta2,alpha,mu,k,m):
  S,E,I,R = y

  # Media factor 
  media_factor = beta1 - (beta2*I)/(alpha+I)

  # The 4 differential equations from the paper
  dSdt = A - media_factor * (S *I / N) - mu *S
  dEdt = media_factor * (S * I / N) - (k + mu) * E
  dIdt = k * E - (m + mu) * I
  dRdt = m * I - mu * R

  return dSdt,dEdt,dIdt,dRdt


# Total population
N = 10000 

# Initial conditions: 1 infected person, 0 exposed, 0 recovered
I0, E0, R0 = 1, 0, 0
S0 = N - I0 - E0 - R0
y0 = S0, E0, I0, R0

# Parameters (guessed for now)
A = 0.1
beta1 = 0.5
beta2 = 0.4
alpha = 10
mu = 0.01
k = 0.1
m = 0.05

# Time vector: 160 days
t = np.linspace(0, 160, 160)

# Solve the equations
result = odeint(seir_model, y0, t, args=(N, A, beta1, beta2, alpha, mu, k, m))
S, E, I, R = result.T

# Plot the results
plt.figure(figsize=(10, 6))
plt.plot(t, S, 'b', label='Susceptible')
plt.plot(t, E, 'y', label='Exposed')
plt.plot(t, I, 'r', label='Infected')
plt.plot(t, R, 'g', label='Recovered')

plt.xlabel('Time (days)')
plt.ylabel('Population')
plt.title('SEIR Model with Media Coverage')
plt.legend()
plt.grid(True)
plt.show()

